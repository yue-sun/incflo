# SAME-FLOW-RATE pair (2026-10-12). 45 deg stays at 2.25 Pa; the 90 deg twin runs at 1.453 Pa.
#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            SIMULATION STOP            #
#.......................................#
stop_time               =   0.5         # Max (simulated) time to evolve
max_step                =   5000        # Max number of time steps (cap; see how far the residual falls)
steady_state            =   1           # Steady-state solver?

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
incflo.fixed_dt         =   -1          # Use this constant dt if > 0
incflo.cfl              =   0.5         # CFL factor
incflo.steady_state_tol =   1.e-4       # Steady-state error tolerance (was 1e-2: stopped 14-18% short in Q)

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
amr.plot_int            =   500            # Steps between plot files (Q(t) for a convergence check)
amr.check_int           =   2500           # Steps between checkpoint files
amr.restart             =   ""          # Checkpoint to restart from

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#               PHYSICS                 #
#.......................................#
incflo.gravity          =   0.  0.  0.  # Gravitational force (3D)
incflo.ro_0             =   1000.0      # Reference density

incflo.fluid_model      =   "newtonian" # Fluid model (rheology)
incflo.mu               =   0.001       # Dynamic viscosity coefficient

incflo.constant_density =   true        #
incflo.advect_momentum  =   true
incflo.advect_tracer    =   true        # Should we update them?
incflo.redistribution_type = FluxRedist	## NoRedist FluxRedist MergeRedist StateRedist

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#           REDOX FLOW BATTERY          #
#.......................................#
# MIRRORED IN X (inlet<->outlet) -- bundled band at the outlet.
# Reconstructed from rotate_45_stagger_only_MN.stp
# 613 spherocylinder fibers, diam 42.0 um.
# NOTE: rfb_num_fibers is informational only -- the solver overrides it with the
#       number of lines actually read from rfb_loc_file (see init.cpp).
incflo.probtype          =   732
incflo.sim_rfb           =   true
incflo.rfb_num_fibers    =   613
incflo.rfb_loc_file      =   "loc.rotate45_flip_electrode"

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
# Domain 6.79 x 3.16 x 0.240 mm (incl. 50 um fluid margin), fibers ~42 um.
# Base grid 408 x 192 x 16 -> dx ~ 16.6, 16.5, 15.0 um (1.3M base cells).
# Base cell size matches the reference deck (80.2, 80.0, 41.5 um), so at the
# same max_level a fiber diameter is resolved by the same number of cells.
# max_level=1 (ref_ratio 2) refines near tagged solids to ~8, 8, 7 um.
amr.n_cell              =   408 192 16    # Grid cells at coarsest AMR level
amr.max_level           =   1             # Max AMR level in hierarchy
amr.ref_ratio           =   2 2 2         # refinement ratio
amr.max_grid_size_x     =   32
amr.max_grid_size_y     =   32
amr.max_grid_size_z     =   32
amr.blocking_factor_x   =   8     # block factor in x-direction
amr.blocking_factor_y   =   8     # block factor in y-direction
amr.blocking_factor_z   =   8     # block factor in z-direction

incflo.tag_region       =   true
incflo.tag_solids       =   true

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo        =   0.0       0.0        0.0        # Lo corner coordinates
geometry.prob_hi        =   6.791945e-03  3.160000e-03  2.400000e-04  # Hi corner (m)
geometry.is_periodic    =   0       0       0       # Periodicity x y z (0/1)

# Boundary conditions
# NOTE: pressure-driven. Holding this deck fixed across designs holds DELTA-P fixed, so
#       the flow rate Q will DIFFER between geometries -- report Q and dp beside any
#       current, or a throughput difference will read as a geometry effect.
xlo.type                =   "pi"
xlo.pressure            =   2.25
xhi.type                =   "po"
xhi.pressure            =   0.

ylo.type                = "nsw"
yhi.type                = "nsw"

zlo.type                = "nsw"
zhi.type                = "nsw"

incflo.geometry = "all_regular"

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              VERBOSITY                #
#.......................................#
amr.verbose              =      0
incflo.verbose           =      1          # incflo itself
mac_proj.verbose         =      0          # MAC Projector
nodal_proj.verbose       =      0          # Nodal Projector
scalar_diffusion.mg_verbose =   0

amr.plotVariables        =   velx vely velz magvel vort density p cell_type
