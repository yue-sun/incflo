#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            SIMULATION STOP            #
#.......................................#
stop_time               =   5.0       # Max (simulated) time to evolve
max_step                =  -1           # Max number of time steps
steady_state            =   0           # Steady-state solver?

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
incflo.fixed_dt         =   -1        # Use this constant dt if > 0
incflo.cfl              =   0.5        # CFL factor
incflo.thermal_cfl      =   0.9

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
amr.plot_per_exact      =   0.1        # Steps between plot files
amr.check_int           =   1000        # Steps between checkpoint files
amr.restart             =   ""          # Checkpoint to restart from

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨
#               PHYSICS                 #
#.......................................#
incflo.advection_type   =   "MOL"      # Options: Godunov, MOL, BDS
incflo.diffusion_type   =   2          # 0: Explicit, 1: Crank-Nicolson, 2: Implicit

incflo.gravity          =   0.  0.  0.  # Gravitational force (3D)
incflo.ro_0             =   1.          # Reference density

incflo.fluid_model      =   "newtonian" # Fluid model (rheology)
incflo.mu               =   0.001966    # Dynamic viscosity coefficient

incflo.use_temperature  =   true
incflo.mu_T             =   0.000244    # For now using thermal diffusivity, but it should be thermal conductivity
incflo.cp               =   1.0         # Set to 1 for now because the temperature update is non-conservative
incflo.temp_iface_smooth_iters  =   0    # sharp interfaces: harmonic face k(T), no smoothing needed
incflo.temp_iface_smooth_weight =   0.55 # Blend factor per pass (0..1), lower is less smoothing

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              CRYO PLUNGING            #
#.......................................#
incflo.probtype         =   3000
incflo.sim_cryo         =   true
incflo.cryo_geometry    =   4
incflo.cryo_disk_init_z =   1.6
incflo.cryo_sample_layer           = 1
incflo.cryo_sample_layer_thickness = 0.05   # 50 um, in mm

incflo.dt_min           =   1e-3
incflo.cryo_plunge_vel  =   -1.0  0.0
incflo.cryo_plunge_time =    0.0  6.0
incflo.cryo_temp_entry  =   273.15
incflo.cryo_temp_eth    =   90.0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell              =   32 8 32  # Grid cells at coarsest AMRlevel
amr.max_level           =   2           # Max AMR level in hierarchy
amr.ref_ratio           =   4 4 4 4
amr.max_grid_size       =   16 16 16  # Max grid size at AMR levels
amr.blocking_factor     =   8           # Blocking factor for grids
amr.grid_eff            =   0.9
amr.n_error_buf         =   2 2

incflo.tag_region       =   true
incflo.tag_region_time  =   0.03
incflo.tag_region_lo    =   -0.5  -0.5  -0.5
incflo.tag_region_hi    =    0.5   0.5   0.0
amr.regrid_int          =   5
incflo.tag_cell_type    =   true
incflo.temperr          =   120. 95.
incflo.gradtemperr      =   10. 1
incflo.gradspeederr     =   0.5 0.1

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo        =   -4.0  -1.0  -8.  # Lo corner coordinates
geometry.prob_hi        =    4.0   1.0  0  # Hi corner coordinates
geometry.is_periodic    =   0   0   0   # Periodicity x y z (0/1)

# Boundary conditions
xlo.type                =   "nsw"
xlo.velocity            =   0.  0.  0.
xhi.type                =   "nsw"
xhi.velocity            =   0.  0.  0.
ylo.type                =   "nsw"
ylo.velocity            =   0.  0.  0.
yhi.type                =   "nsw"
yhi.velocity            =   0.  0.  0.
zlo.type                =   "nsw"
zlo.velocity            =   0.  0.  0.
zlo.tracer              =   1.
zhi.type                =   "pi"
zhi.pressure            =   0.0
zhi.temperature         =   270.

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#           INITIAL CONDITIONS          #
#.......................................#
#incflo.ic_u             =   0.0         #
#incflo.ic_v             =   0.0         #
#incflo.ic_w             =   0.0         #
#incflo.ic_p             =   0.0         #

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              VERBOSITY                #
#.......................................#
amr.verbose             =   2
incflo.verbose          =   2          # incflo itself
mac_proj.verbose        =   0          # MAC Projector
nodal_proj.verbose      =   0          # Nodal Projector

scalar_diffusion.verbose  =   0         # Scalar Diffusion
tensor_diffusion.verbose  =   0         # Tensor Diffusion

incflo.initial_iterations =   0

amr.plotVariables       =   velx vely velz magvel vort density tracer temperature cell_type p cp thermal_conductivity
#------------------------------------------------------------------#
# E5: gear-rim wiper — PTFE annulus at the disk edge with teeth   #
# extruding in ±y. The base ring occupies r = 1.3–1.5 mm and is  #
# flush with the disk in y (±0.08 mm). At each of the 12 tooth   #
# sectors (50% duty) the ring protrudes an additional ±0.1 mm in #
# y, forming a crown-gear profile that sheds axial vorticity as  #
# the disk enters the cryogen.                                    #
#------------------------------------------------------------------#
incflo.cryo_n_solids = 1

incflo.cryo_solid_0_shape        = gear_rim
incflo.cryo_solid_0_attach       = plunger
incflo.cryo_solid_0_material     = -4        # PTFE
incflo.cryo_solid_0_rim_r_inner  = 1.5       # mm — inner edge of the ring
incflo.cryo_solid_0_rim_r_outer  = 1.6       # mm — outer edge = disk radius
incflo.cryo_solid_0_rim_zc       = 1.6       # mm — disk center z' (co-moving)
incflo.cryo_solid_0_rim_base_hy  = 0.08      # mm — y half-thickness of the base ring (= disk half-width)
incflo.cryo_solid_0_rim_tooth_h  = 0.15       # mm — additional ±y extrusion at tooth sectors
incflo.cryo_solid_0_rim_nteeth   = 36        # number of teeth around the ring
incflo.cryo_solid_0_rim_duty     = 0.5       # tooth angular fraction per pitch (0 = no teeth, 1 = full ring)
