#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#   PRODUCTION RUN IN THE LE CUP (EB)   #
#.......................................#
# Measured gold grid + mixed3 samples, plunged with the measured sample-plunge
# trajectory (sample_experiment), in the LE cup with 10 mm of ethane.
#
# Setup from inputs.cryo_cup_eb_l0 (full resolution: finest dx 3.906 um) with the cup
# wall as an EB on level 0 (0.5 mm) only -- incflo.eb_level0_only.  Levels 1-7
# use an all-regular EB index space and are kept incflo.eb_refine_margin
# level-0 cells (4 mm) away from the wall, so the EB costs MBs, not TBs.
#
# Refinement ratio 2 throughout: in an EB build AMReX's nodal projection
# (MLNodeLaplacian, RAP coarsening -- the only one with constant density)
# asserts ref_ratio 2 between all AMR levels.  0.5 mm base x 2^7 = 3.906 um,
# the same finest dx as the 1 mm x 4^4 hierarchy of the non-EB runs.
# The flow 2.5 mm from the old 8 mm box walls was < 1% of the plunge speed
# (prod_L4_2gpu_1006_234126/diags/wall_flow_level0.png), so the 0.5 mm wall
# and the 4 mm keep-out cost nothing near the grid (r < 1.6 mm).
#
# LE depth 10 mm: the floor (zlo) is 10 mm below the surface.  The grid's
# bottom edge reaches at most 6.78 mm (sample_experiment), 3.2 mm above it.
# 20 level-0 cells in z is not a multiple of 8, so level 0 uses blocking
# factor 4.

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            SIMULATION STOP            #
#.......................................#
stop_time               =   10.0       # Max (simulated) time to evolve [ms]
max_step                =  -1           # Max number of time steps
steady_state            =   0           # Steady-state solver?

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
incflo.fixed_dt         =   -1        # Use this constant dt if > 0
incflo.cfl              =   0.5        # CFL factor
incflo.thermal_cfl      =   10000.0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
amr.plot_per_exact      =   0.1        # Simulated time between plot files [ms]
amr.check_int           =   5000        # Steps between checkpoint files
amr.restart             =   ""          # Checkpoint to restart from
fab.format              =   NATIVE_32

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨
#               PHYSICS                 #
#.......................................#
incflo.advection_type   =   "Godunov"      # Options: Godunov, MOL, BDS
incflo.diffusion_type   =   2          # 0: Explicit, 1: Crank-Nicolson, 2: Implicit

incflo.gravity          =   0.  0.  0.  # Gravitational force (3D)
incflo.ro_0             =   1.          # Reference density

incflo.fluid_model      =   "newtonian" # Fluid model (rheology)
incflo.mu               =   0.001966    # Dynamic viscosity coefficient

incflo.use_temperature  =   true
incflo.mu_T             =   0.000244    # For now using thermal diffusivity, but it should be thermal conductivity
incflo.cp               =   1.0         # Set to 1 for now because the temperature update is non-conservative
incflo.temp_iface_smooth_iters  =   4    # thin gold mesh bars: soften k(T)/cp(T) jump at metal/ethane interface; stabilizes implicit T-diffusion MLMG
incflo.temp_iface_smooth_weight =   0.55 # Blend factor per pass (0..1), lower is less smoothing

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              CRYO PLUNGING            #
#.......................................#
incflo.probtype         =   3000
incflo.sim_cryo         =   true
incflo.cryo_geometry    =   6           # 6 = gold EM grid, measured (height map from incflo.cryo_grid_file)
incflo.cryo_grid_file   =   "../../data/grids/grid_Au_carbon_realAu300QuantifoilR14_v260930.hmap"
incflo.cryo_sample_layer = 0
incflo.cryo_sample_place = "../../data/samples/cells.samples_mixed3"

incflo.dt_min           =   1e-3        # NB: only a floor when the CFL number is ~0, not a general minimum
incflo.cryo_plunge_protocol = sample_experiment
incflo.cryo_temp_entry  =   273.15
incflo.cryo_temp_eth    =   90.0

incflo.cryo_temp_stats_file = temperature_stats_prod_run_cup.dat
incflo.cryo_temp_stats_int  = 1

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell              =   112 112 20  # 0.5 mm base cells over 56 x 56 x 10 mm
amr.max_level           =   7           # dx: 0.5 0.25 0.125 0.0625 0.03125 0.015625 0.0078125 0.00390625 mm
amr.ref_ratio           =   2 2 2 2 2 2 2
amr.max_grid_size       =   32 32 32 32 64 64 64 64  # per LEVEL
amr.blocking_factor     =   4 8 8 8 8 8 8 8  # per LEVEL; 4 on level 0 (20 cells in z)
amr.grid_eff            =   0.9
amr.n_error_buf         =   2 2 2 2 2 2 2 2

# Tagging: entry n is applied on level n (dx below) to make level n+1, matched
# by resolution to the non-EB runs (0.25 mm: 155/20/0.9, 0.0625 mm: 120/10/0.5,
# 0.015625 mm: -/5/-), halfway values in between.  The difference criteria are
# not divided by dx, so on ratio-2 levels they are a little stricter than the
# same numbers on ratio-4 levels -- tune after the first test.
#   level:   0      1      2      3      4       5       6
#   dx um:   500    250    125    62.5   31.25   15.6    7.8
#
# Check in the calibration run: if covered cells outside the cup hold T = 0 or
# u = 0 next to 90 K / moving ethane, gradtemperr would tag the whole cup wall
# on every level (the tagging in incflo_tagging.cpp does not skip covered
# cells).  The far field is quiescent, so look at the level-1 grid summary: it
# should be a few % of the domain, not a ring at r = 25.4 mm.
incflo.tag_region       =   true
incflo.tag_region_time  =   0.03
incflo.tag_region_lo    =   -0.5  -0.5  -0.5   # as the non-EB runs: 0.5 mm cell centres (+-0.25) fall inside;
incflo.tag_region_hi    =    0.5   0.5   0.0   # +-1 mm made 8x the finest cells at startup (74 M vs 10 M)
amr.regrid_int          =   2
amr.max_grid_iterations =   1           # startup re-tag passes (default 4); the cryo regrid follows anyway
incflo.tag_cell_type    =   true
incflo.temperr          =   155. 155. 155. 120. 120. 1.e9 1.e9
incflo.gradtemperr      =   20.  20.  10.  10.  5.   5.   5.
incflo.gradspeederr     =   0.9  0.9  0.5  0.5  0.5  1.e9 1.e9

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo        =   -28.0  -28.0  -10.0  # z: 10 mm of LE; keep prob_hi z = 0
geometry.prob_hi        =    28.0   28.0    0.0
geometry.is_periodic    =   0   0   0   # Periodicity x y z (0/1)

# LE cup side wall: 2.0" ID.  Covered cells outside it are skipped by the
# solvers, so the box faces at x, y = +-28 never see fluid.
incflo.geometry         =   "cylinder"
cylinder.internal_flow  =   true
cylinder.radius         =   25.4
cylinder.direction      =   2
cylinder.center         =   0.0  0.0  0.0
incflo.eb_level0_only   =   true        # the wall exists on level 0 only (0.5 mm)
incflo.eb_refine_margin =   8           # no level >= 1 within 8 level-0 cells (4 mm) of it
amr.refine_cutcells     =   0           # don't tag the wall (it would be cleared anyway)

# Boundary conditions
xlo.type                =   "nsw"       # x/y faces lie outside the cup (covered)
xlo.velocity            =   0.  0.  0.
xhi.type                =   "nsw"
xhi.velocity            =   0.  0.  0.
ylo.type                =   "nsw"
ylo.velocity            =   0.  0.  0.
yhi.type                =   "nsw"
yhi.velocity            =   0.  0.  0.
zlo.type                =   "nsw"       # cup floor
zlo.velocity            =   0.  0.  0.
zlo.tracer              =   1.
zhi.type                =   "pi"        # ethane surface
zhi.pressure            =   0.0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              VERBOSITY                #
#.......................................#
amr.verbose             =   2
incflo.verbose          =   2          # incflo itself
mac_proj.verbose        =   0          # MAC Projector
nodal_proj.verbose      =   1          # Nodal Projector: show MLMG iterations (initial projection is silent otherwise)
nodal_proj.mg_rtol      =   1e-9

scalar_diffusion.verbose  =   0         # Scalar Diffusion
tensor_diffusion.verbose  =   0         # Tensor Diffusion

incflo.initial_iterations =   0

amr.plotVariables       =   velx vely velz magvel vort density tracer temperature cell_type p cp thermal_conductivity
